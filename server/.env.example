# Ambil dari Neon dashboard -> project "go-productive-app" -> Connect
# Pooled connection (dipakai runtime app, ada "-pooler" di hostname)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Direct connection (dipakai Prisma untuk migrations, tanpa "-pooler")
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

PORT=3001
FRONTEND_URL="http://localhost:5173"

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID
GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"

# Random secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"
